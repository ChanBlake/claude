{
  "name": "drift-station-salvage",
  "productName": "DRIFT",
  "version": "1.0.0",
  "description": "A sci-fi puzzle platformer about rewinding time, inverting gravity, and decisions you cannot walk back.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node serve.mjs",
    "verify": "node tools/verify.mjs",
    "sector": "node tools/verify.mjs --sector",
    "editor": "node serve.mjs --no-open && echo open http://localhost:5173/tools/editor.html",
    "test": "node tools/verify.mjs",
    "start": "node serve.mjs",
    "dist": "node build.mjs --all",
    "dist:win": "node tools/verify.mjs && electron-builder --win",
    "app": "electron .",
    "exe": "node build.mjs --win --portable",
    "build": "node build.mjs",
    "compose": "python3 tools/compose.py && node tools/verify.mjs",
    "bundle": "node tools/bundle.mjs",
    "levels": "python3 tools/compose.py && node tools/verify.mjs && node tools/bundle.mjs",
    "secrets": "python3 tools/find-secrets.py",
    "heatmap": "node serve.mjs --no-open && echo open http://localhost:5173/tools/heatmap.html"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourstudio.drift",
    "productName": "DRIFT",
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "build/icon.*",
      "!tools/**/*",
      "!dist/**/*",
      "!**/*.md",
      "!serve.mjs",
      "!build.mjs",
      "!*.bat",
      "!*.command"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "DRIFT-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "icon": "build/icon.png",
      "category": "Game"
    },
    "portable": {
      "artifactName": "DRIFT-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "DRIFT",
      "createDesktopShortcut": true
    },
    "compression": "maximum"
  }
}